# PulseGuard AI Environment Configuration

APP_NAME="PulseGuard AI - Health Monitoring & Anomaly Detection System"
APP_VERSION="1.0.0"
DEBUG=True

# Local Database (SQLite default)
DATABASE_URL="sqlite:///./health_monitoring.db"

# ----------------------------------------------------
# Supabase Cloud Database & Storage Configuration
# ----------------------------------------------------
# 1. Sign up at https://supabase.com and create a project.
# 2. Go to Project Settings -> API to find your Project URL and anon public key.
# 3. Paste them below:

SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# (Optional) Supabase Direct PostgreSQL Connection String:
# Found under Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=""

# Sync behavior
SUPABASE_SYNC_ENABLED=True
SUPABASE_AUTO_SYNC=False
